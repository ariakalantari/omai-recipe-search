# Dataset and local indexes
RECIPE_DATA_PATH=data/enriched
REQUIRE_INSTRUCTIONS=true
INDEX_CACHE_DIR=data/cache
EMBEDDING_CACHE_DIR=data/models
SEMANTIC_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_PARALLEL_WORKERS=1
EMBEDDING_INDEX_CHUNK_SIZE=16384
# MAX_RECIPES=10000

# Bound local work and raw API payloads for a public demo.
MAX_CONCURRENT_SEARCHES=4
MAX_REQUEST_BODY_BYTES=16384

# Exact browser origins allowed to call the API. Never use * for the public demo.
# CORS_ORIGINS=https://ariakalantari.github.io

# Optional Azure OpenAI query interpretation. The app works without these.
# Include the /openai/v1/ suffix, for example:
AZURE_OPENAI_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-luna
AZURE_OPENAI_REASONING_EFFORT=low
AZURE_OPENAI_TIMEOUT_SECONDS=3

# Local or non-Azure hosts: set at runtime, never during docker build.
AZURE_OPENAI_API_KEY=

# Azure Container Apps: leave the key empty and use managed identity instead.
AZURE_OPENAI_USE_ENTRA=false

# Protect paid AI calls on a public demo. Search itself remains available after the limit.
AI_REQUESTS_PER_MINUTE=20
AI_REQUESTS_PER_CLIENT_MINUTE=5
